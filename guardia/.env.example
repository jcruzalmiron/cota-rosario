# Copiar a .env.local (local) o cargar en el gestor de secretos aprobado. No commitear valores reales.

# Base: con DATABASE_URL usa Postgres; sin ella (sólo fuera de producción) usa PGlite en PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Identidad: dev-local habilita usuarios ficticios SOLO con NODE_ENV distinto de production.
# Para el piloto: integrar el proveedor aprobado (OIDC) y dejar esto vacío.
AUTH_MODE=dev-local

# O3 · Avisos de guardia (regla propuesta; confirmar con jefes de guardia)
ALERTA_PRIMER_AVISO_MIN=10
# Seguimiento desde la última novedad. Vacío = sin seguimiento automático hasta acordar la regla.
ALERTA_SEGUIMIENTO_MIN=

# Adaptadores externos: arrancan apagados. Con =on y variables faltantes, la app no arranca (error visible).
ADAPTER_TRANSCRIPCION=off
TRANSCRIPCION_URL=
ADAPTER_IA_EXTRACCION=off
IA_EXTRACCION_PROVEEDOR=
IA_EXTRACCION_API_KEY=
ADAPTER_BRAVO_EXPORT=off
BRAVO_CONTRATO_VERSION=
ADAPTER_WHATSAPP=off
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
